# Rust
core/target/
**/*.rs.bk

# UniFFI-generated Swift bindings (regenerated by scripts/gen-bindings.sh)
app/Generated/

# XcodeGen output and Xcode state
# Info.plist is generated from the `info:` block in app/project.yml on every
# `xcodegen generate` (docs/DECISIONS.md D-0009). app/Brev.entitlements is NOT
# listed here: it is checked in so the entitlement set is reviewable in a diff.
app/Info.plist
app/*.xcodeproj/
app/*.xcworkspace/
app/build/
app/build-b/
app/DerivedData/
# tools/verify (built into core/target/verify): TouchIDProbe's generated project,
# and what the spike scripts in tools/verify/spikes build and write next to themselves
tools/verify/touchid-probe/*.xcodeproj/
tools/verify/spikes/**/build/
tools/verify/spikes/**/bin/
tools/verify/spikes/**/out/
tools/verify/spikes/**/target/
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Build products
/build/
/dist/
*.app
*.dSYM/
*.dSYM.zip
*.xcarchive

# macOS
.DS_Store
._*

# Editors
.idea/
.vscode/
*.swp
*.swo

# Local secrets and data directories must never be committed
*.sqlite
*.sqlite-*
*.db
.env
.env.*
