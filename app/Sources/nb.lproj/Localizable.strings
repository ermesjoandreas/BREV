"onboarding.rules.create" = "Opprett nøkler";
"onboarding.working" = "Oppretter nøkler …";

/* Onboarding, page 3: the first unlock. */
"onboarding.first.title" = "Lås opp for første gang";
"onboarding.first.body" = "Bekreft med Touch ID at nøklene virker. Først da er Brev klar til bruk.";

/* Onboarding errors. */
"onboarding.error.notouchid" = "Brev krever Touch ID. Sett opp Touch ID i Systeminnstillinger, og åpne Brev på nytt.";
"onboarding.error.failed" = "Nøklene kunne ikke lages.";
"onboarding.error.retry" = "Prøv igjen";

/* Shown alone when Brev was started with debugging switches (docs/PHASE2_DESIGN.md §8.6). */
"launch.error.unsafe" = "Brev ble startet på en måte som ikke er trygg, og kan ikke låses opp nå. Avslutt Brev og åpne det på nytt fra Programmer-mappen.";

/* The lock screen. unlock.reason completes macOS's sentence «Brev» prøver å … in the Touch ID dialog. */
"unlock.title" = "Brev er låst";
"unlock.button" = "Lås opp med Touch ID";
"unlock.cancel" = "Avbryt";
"unlock.reason" = "låse opp brevene dine";

/* Unlock errors (docs/PHASE2_DESIGN.md §5.5). */
"unlock.error.retry" = "Brev ble ikke låst opp. Prøv igjen.";
"unlock.error.lockout" = "Touch ID er sperret etter for mange forsøk. Lås Macen, logg inn med passordet, og prøv igjen.";
"unlock.error.unavailable" = "Touch ID er ikke tilgjengelig. Brev kan bare låses opp med Touch ID.";
"unlock.error.fingers" = "Fingeravtrykkene på denne Macen ser ut til å være endret. Da kan brevene ikke åpnes igjen.";
"unlock.error.damaged" = "Filene til Brev er skadet. Brevene kan ikke åpnes.";

/* Reset, and its confirmation sheet. */
"reset.button" = "Slett alt og start på nytt";
"reset.confirm.title" = "Slette alle brev?";
"reset.confirm.body" = "Alle brev og nøkler på denne Macen blir slettet. Dette kan ikke angres.";
"reset.confirm.ok" = "Slett alt";
"reset.confirm.cancel" = "Avbryt";

/* The address page (docs/PHASE3_DESIGN.md §6.5, §6.6), after unlock until an address is registered. No string here takes an address, a name or a code: those are drawn only in the protected layer (§6.4). register.reason completes macOS's sentence «Brev» prøver å … in the Touch ID dialog. After net.error, Registrer sends the registration already signed again, without Touch ID. */
"address.title" = "Velg adressen din";
"address.body" = "Andre legger deg til med denne adressen. 3–32 tegn: a–z, 0–9 og bindestrek. Den kan ikke endres senere.";
"address.register" = "Registrer";
"register.reason" = "registrere adressen din";
"address.error.taken" = "Adressen er tatt. Velg en annen.";
"address.error.invalid" = "Adressen kan bare ha a–z, 0–9 og bindestrek, og må begynne med en bokstav.";
"address.error.failed" = "Adressen ble ikke registrert. Prøv igjen.";

/* The address page's first step (docs/PHASE4_DESIGN.md §6.1): a new identity needs an invite code to register. The code is pasted with ⌘V (or typed) and drawn only in the protected layer; «Invitert av:» stands beside the inviter's address and code, which are drawn there too. */
"address.invite.title" = "Lim inn invitasjonen";
"address.invite.body" = "Du trenger en invitasjonskode fra en som bruker Brev. Lim den inn med ⌘V.";
"address.invite.next" = "Fortsett";

/* The mail window. %@ is a date from DateFormatter (nb): metadata, never content. */
"mail.new" = "Nytt brev";
"mail.lock" = "Lås";
"mail.nothreads" = "Ingen brev ennå";
"mail.sent" = "Sendt %@";
"mail.received" = "Mottatt %@";

/* The compose sheet. */
"compose.to" = "Til:";
"compose.subject" = "Emne:";
"compose.send" = "Send";
"compose.cancel" = "Avbryt";
"compose.error" = "Brevet ble ikke sendt. Prøv igjen.";
/* Sending a letter (docs/PHASE3_DESIGN.md §6.5, §6.6). send.reason completes macOS's sentence «Brev» prøver å … in the Touch ID dialog. compose.retry sends the letter already signed again, without Touch ID. */
"send.reason" = "sende brevet";
"compose.sending" = "Sender …";
"compose.keychanged" = "Sikkerhetskoden til mottakeren er endret. Brevet ble ikke sendt.";
/* The relay's refusals (docs/PHASE4_DESIGN.md §6.1, §6.3): the recipient has not approved the sender (or declined, which the sender is not told apart), or the daily letter limit is reached. The draft stays. */
"compose.notapproved" = "Mottakeren har ikke godtatt deg ennå. Brevet ble ikke sendt.";
"compose.ratelimited" = "Du har sendt for mange brev i dag. Brevet ble ikke sendt.";
"compose.retry" = "Prøv igjen";
"net.error" = "Fikk ikke kontakt med Brev-tjenesten. Prøv igjen.";
/* A letter Rust refused because Brev's report on its own defences was not complete (docs/VAULT_SPLIT_PLAN.md §6, owner answer Q6). %@ is a list of the environment.* texts below, joined by ", ". */
"compose.environment" = "Brevet ble ikke sendt: %@.";
"environment.keyorigin" = "nøkkelen er ikke i Secure Enclave";
"environment.biometric" = "ikke låst opp med Touch ID";
"environment.capture" = "opptaksvern av";
"environment.secureinput" = "sikker inntasting av";
"environment.synthetic" = "vern mot kunstig inndata av";
"environment.accessibility" = "skjerming mot tilgjengelighetsverktøy av";
"environment.pasteboard" = "sperre mot utklippstavlen av";
"environment.noreport" = "Brev sjekket ikke vernet sitt først";

