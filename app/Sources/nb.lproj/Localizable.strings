"contacts.title" = "Kontakter";
"contacts.me" = "Din adresse:";
"contacts.copyme" = "Kopier adressen min";
"contacts.field" = "Adresse eller invitasjonskode:";
"contacts.add" = "Legg til";
"contacts.close" = "Lukk";
"invite.make" = "Lag invitasjon";
"invite.copy" = "Kopier koden";
"invite.note" = "Koden kan brukes én gang og gjelder i 7 dager. Send den til én person.";
"invite.from" = "Invitert av:";
