/*
  Localizable.strings — Brev, Norwegian bokmål (nb), UTF-8.

  Every user-visible string in the app lives here (CLAUDE.md §3.2), read
  through App/L10n.swift. The texts are those of docs/PHASE2_DESIGN.md §5.6,
  docs/PHASE3_DESIGN.md §6.6 and docs/PHASE4_DESIGN.md §6.3.
  None of these strings may ever be derived from message content (§1.5),
  and none takes an address, a name or an identity code (PHASE3 §6.4).
*/

